{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "app/main.py"
    }
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/v1/scan/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/gsc/cron",
      "schedule": "30 7 * * *"
    }
  ]
}
