{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/v1/scan/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/gsc/cron",
      "schedule": "30 7 * * *"
    }
  ]
}
