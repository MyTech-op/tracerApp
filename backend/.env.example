[TEMPLATE]
# MySQL (docker-compose default)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/seoops_db
# Postgres (Neon / managed Postgres) — same models, just swap the dialect:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/seoops_db?sslmode=require
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: secret guarding the /scan/cron endpoint used by Vercel Cron.
# Leave empty to disable cron scanning entirely.
CRON_SECRET=

# AI Configuration
AI_PROVIDER=gemini  # "gemini" or "openai"
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
