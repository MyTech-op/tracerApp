# SEOOps Backend Environment Template
# Copy to .env and fill in real values.

# MySQL (docker-compose default)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/seoops_db
# Postgres (Neon / managed Postgres) — same models, just swap the dialect:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/seoops_db?sslmode=require
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: secret guarding the /scan/cron endpoint used by Vercel Cron.
# Leave empty to disable cron scanning entirely.
CRON_SECRET=

# AI Configuration
AI_PROVIDER=gemini  # "gemini" or "openai"
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Google Search Console OAuth (optional — required to show real click/impression trends)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials with
# scope https://www.googleapis.com/auth/webmasters.readonly and redirect URI:
#   GSC_REDIRECT_URI=http://localhost:8000/api/v1/gsc/callback  (production: your deployed backend)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8000/api/v1/gsc/callback
FRONTEND_URL=http://localhost:3000

# Stripe billing (optional — set STRIPE_SECRET_KEY to activate checkout/portal/webhook)
# Price IDs are optional: leave blank and SEOOps auto-creates the prices on first checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
